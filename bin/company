#!/usr/bin/env bash

set -euo pipefail

profiles_dir="${XDG_CONFIG_HOME:-$HOME/.config}/company"

usage() {
  printf '%s\n' \
    'Usage:' \
    '  company add NAME --vault VAULT [--account ACCOUNT] [--default KEY=VALUE] KEY=Item/field [...]' \
    '  company edit NAME' \
    '  company list' \
    '  company check NAME' \
    '  company run NAME -- COMMAND [...]' \
    '  company shell NAME'
}

validate_name() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || { printf 'Invalid company name: %s\n' "$1" >&2; exit 2; }
}

profile_path() {
  printf '%s/%s.toml\n' "$profiles_dir" "$1"
}

toml_string() {
  jq -Rn --arg value "$1" '$value'
}

require_fnox() {
  command -v fnox >/dev/null 2>&1 || { printf 'fnox is required.\n' >&2; exit 1; }
}

has_gum_ui() {
  command -v gum >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]
}

command_name="${1:-}"
[[ -n "$command_name" ]] || { usage; exit 2; }
shift

case "$command_name" in
  add)
    name="${1:-}"
    if [[ -z "$name" ]] && has_gum_ui; then
      gum style --bold --border rounded --padding '0 1' 'New company profile'
      name="$(gum input --header 'Company name' --placeholder 'acme')"
    fi
    [[ -n "$name" ]] || { usage >&2; exit 2; }
    validate_name "$name"
    (($# == 0)) || shift
    account=""
    vault=""
    references=()
    defaults=()
    while (($# > 0)); do
      case "$1" in
        --account)
          (($# >= 2)) || { usage >&2; exit 2; }
          account="$2"
          shift 2
          ;;
        --vault)
          (($# >= 2)) || { usage >&2; exit 2; }
          vault="$2"
          shift 2
          ;;
        --default)
          (($# >= 2)) || { usage >&2; exit 2; }
          defaults+=("$2")
          shift 2
          ;;
        --)
          shift
          references+=("$@")
          break
          ;;
        -*)
          printf 'Unknown option: %s\n' "$1" >&2
          exit 2
          ;;
        *)
          references+=("$1")
          shift
          ;;
      esac
    done
    if has_gum_ui; then
      if [[ -z "$account" ]] && gum confirm 'Use a specific 1Password account?'; then
        account="$(gum input --header '1Password account' --placeholder 'company.1password.com')"
      fi
      if [[ -z "$vault" ]]; then
        vault="$(gum input --header '1Password vault' --placeholder 'Employee')"
      fi
      if ((${#references[@]} + ${#defaults[@]} == 0)); then
        profile_type="$(gum choose --header 'Credential profile' 'AWS credentials' 'Custom variables')"
        if [[ "$profile_type" == 'AWS credentials' ]]; then
          item="$(gum input --header '1Password item' --value 'AWS')"
          region="$(gum choose --header 'AWS default region' us-east-1 us-east-2 sa-east-1 eu-west-1 'Other')"
          if [[ "$region" == Other ]]; then
            region="$(gum input --header 'AWS default region' --placeholder 'us-east-1')"
          fi
          secret_key_name='AWS_SECRET_ACCESS_KEY'
          references+=("AWS_ACCESS_KEY_ID=${item}/AWS_ACCESS_KEY_ID")
          references+=("${secret_key_name}=${item}/${secret_key_name}")
          defaults+=("AWS_DEFAULT_REGION=${region}")
        else
          reference="$(gum input --header 'Secret reference' --placeholder 'KEY=Item/field')"
          default="$(gum input --header 'Optional default' --placeholder 'KEY=value')"
          [[ -z "$reference" ]] || references+=("$reference")
          [[ -z "$default" ]] || defaults+=("$default")
        fi
      fi
    fi
    [[ -n "$vault" ]] || { printf 'Provide the 1Password vault with --vault.\n' >&2; exit 2; }
    ((${#references[@]} + ${#defaults[@]} > 0)) || { printf 'Provide at least one secret reference or default value.\n' >&2; exit 2; }
    keys=()
    values=()
    default_keys=()
    default_values=()
    seen_keys=" "
    for reference in "${references[@]}"; do
      [[ "$reference" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.+)$ ]] || { printf 'Invalid reference: %s\n' "$reference" >&2; exit 2; }
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      [[ "$seen_keys" != *" $key "* ]] || { printf 'Duplicate variable: %s\n' "$key" >&2; exit 2; }
      seen_keys+="$key "
      keys+=("$key")
      values+=("$value")
    done
    for default in "${defaults[@]}"; do
      [[ "$default" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || { printf 'Invalid default: %s\n' "$default" >&2; exit 2; }
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      [[ "$seen_keys" != *" $key "* ]] || { printf 'Duplicate variable: %s\n' "$key" >&2; exit 2; }
      seen_keys+="$key "
      default_keys+=("$key")
      default_values+=("$value")
    done
    command -v jq >/dev/null 2>&1 || { printf 'jq is required.\n' >&2; exit 1; }
    mkdir -p "$profiles_dir"
    chmod 700 "$profiles_dir"
    destination="$(profile_path "$name")"
    if [[ -e "$destination" ]]; then
      if ! has_gum_ui || ! gum confirm "Replace profile $name?"; then
        printf 'Profile already exists: %s\n' "$destination" >&2
        exit 1
      fi
    fi
    umask 077
    temporary="$(mktemp "${profiles_dir}/.${name}.XXXXXX")"
    {
      printf 'env = "exec"\n'
      printf 'if_missing = "error"\n\n'
      printf '[providers.company]\n'
      printf 'type = "1password"\n'
      [[ -z "$account" ]] || printf 'account = %s\n' "$(toml_string "$account")"
      printf 'vault = %s\n\n' "$(toml_string "$vault")"
      printf '[secrets]\n'
      for ((index = 0; index < ${#keys[@]}; index++)); do
        printf '%s = { provider = "company", value = %s }\n' "${keys[$index]}" "$(toml_string "${values[$index]}")"
      done
      for ((index = 0; index < ${#default_keys[@]}; index++)); do
        printf '%s = { default = %s }\n' "${default_keys[$index]}" "$(toml_string "${default_values[$index]}")"
      done
    } > "$temporary"
    mv "$temporary" "$destination"
    if has_gum_ui; then
      gum style --bold --foreground 42 "Created $destination"
    else
      printf '%s\n' "$destination"
    fi
    ;;
  edit)
    name="${1:-}"
    [[ -n "$name" ]] || { usage >&2; exit 2; }
    validate_name "$name"
    destination="$(profile_path "$name")"
    [[ -f "$destination" ]] || { printf 'Profile not found: %s\n' "$destination" >&2; exit 1; }
    "${EDITOR:-vi}" "$destination"
    ;;
  list)
    [[ -d "$profiles_dir" ]] || exit 0
    find "$profiles_dir" -maxdepth 1 -type f -name '*.toml' -exec basename {} .toml \; | sort
    ;;
  check)
    name="${1:-}"
    [[ -n "$name" ]] || { usage >&2; exit 2; }
    validate_name "$name"
    destination="$(profile_path "$name")"
    [[ -f "$destination" ]] || { printf 'Profile not found: %s\n' "$destination" >&2; exit 1; }
    require_fnox
    fnox --config "$destination" check
    ;;
  run)
    name="${1:-}"
    [[ -n "$name" ]] || { usage >&2; exit 2; }
    validate_name "$name"
    shift
    [[ "${1:-}" == -- ]] || { usage >&2; exit 2; }
    shift
    (($# > 0)) || { usage >&2; exit 2; }
    destination="$(profile_path "$name")"
    [[ -f "$destination" ]] || { printf 'Profile not found: %s\n' "$destination" >&2; exit 1; }
    require_fnox
    exec fnox --config "$destination" exec --replace -- "$@"
    ;;
  shell)
    name="${1:-}"
    [[ -n "$name" ]] || { usage >&2; exit 2; }
    validate_name "$name"
    destination="$(profile_path "$name")"
    [[ -f "$destination" ]] || { printf 'Profile not found: %s\n' "$destination" >&2; exit 1; }
    require_fnox
    exec fnox --config "$destination" exec --replace -- "${SHELL:-/bin/zsh}" -l
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
