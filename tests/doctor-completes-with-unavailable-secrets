#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

mkdir -p "$test_root/bin" "$test_root/company"
printf '#!/usr/bin/env bash\nsleep 30\n' > "$test_root/bin/fnox"
chmod +x "$test_root/bin/fnox"
printf '#!/usr/bin/env bash\nprintf "tmutil: No destinations configured.\\n"\n' > "$test_root/bin/tmutil"
chmod +x "$test_root/bin/tmutil"
printf 'env = "exec"\n' > "$test_root/company/example.toml"
chmod 600 "$test_root/company/example.toml"

set +e
PATH="$test_root/bin:$PATH" XDG_CONFIG_HOME="$test_root" \
  /usr/bin/perl -e 'alarm shift; exec @ARGV' 5 "$repo_root/bin/doctor" > "$test_root/output" 2>&1
set -e

if ! grep -Eq '^[0-9]+ passed, [0-9]+ warnings, [0-9]+ failures$' "$test_root/output"; then
  printf 'dotfiles-doctor did not finish while secrets were unavailable:\n' >&2
  cat "$test_root/output" >&2
  exit 1
fi

if ! grep -Fq '[WARN] Time Machine has no backup destination' "$test_root/output"; then
  printf 'dotfiles-doctor accepted a missing Time Machine destination:\n' >&2
  cat "$test_root/output" >&2
  exit 1
fi

printf 'doctor completion test passed\n'
